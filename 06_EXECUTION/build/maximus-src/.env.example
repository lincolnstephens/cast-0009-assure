# Neon Postgres connection string (serverless driver in production).
# Local dev example (Docker): postgresql://postgres:maximus_dev@localhost:5544/maximus
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Anthropic API key for the Policy Guide. If absent, the Guide falls back to
# the deterministic keyword-matching stub - the app still demos without it.
ANTHROPIC_API_KEY=

# Used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Seed passwords — REQUIRED for pnpm seed / seed:demo / seed:reset. Set real
# values in .env only; never commit them. Not printed in README.
SEED_CLIENT_PASSWORD=
SEED_OFFICER_PASSWORD=
